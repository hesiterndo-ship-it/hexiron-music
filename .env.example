# ── Telegram ──────────────────────────────────────────────────────────
BOT_TOKEN=123456789:your-telegram-bot-token
API_ID=1234567
API_HASH=your-telegram-api-hash
OWNER_ID=123456789
# Comma-separated additional admin IDs (optional)
ADMIN_IDS=

# Run `python generate_session.py` once to create this
STRING_SESSION=

# ── Proxy (optional — used for Telegram connection and downloads) ─────
SOCKS5_PROXY_URL=socks5://user:pass@host:port

# ── Licensing (optional) ─────────────────────────────────────────────
CENTRAL_API_URL=http://localhost:8080
CENTRAL_API_KEY=
PRODUCT_ID=music
CENTRAL_BOT_USERNAME=

# ── Storage paths ─────────────────────────────────────────────────────
DATA_DIR=/data
STORAGE_DIR=/data/storage
TEMP_DIR=/data/temp
DOWNLOAD_DIR=/data/downloads
UPLOAD_DIR=/data/uploads
CACHE_DIR=/data/cache
LOG_DIR=/data/logs

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=/data/hexiron.db

# ── AI integration (optional) ────────────────────────────────────────
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ── Player defaults ──────────────────────────────────────────────────
DEFAULT_VOLUME=100
MAX_QUEUE_SIZE=200
MAX_UPLOAD_SIZE_MB=50

# ── Cleanup ──────────────────────────────────────────────────────────
TEMP_FILE_MAX_AGE_HOURS=6
CLEANUP_INTERVAL_MINUTES=30

# ── Music providers ──────────────────────────────────────────────────
# yt-dlp extraction timeout (seconds)
YTDLP_TIMEOUT=30
# Path to yt-dlp cookies file for age-restricted content (optional)
YTDLP_COOKIES_FILE=
# Generic URL download max size in bytes (default: 200MB)
GENERIC_MAX_SIZE_BYTES=209715200
# Generic URL download timeout in seconds
GENERIC_DOWNLOAD_TIMEOUT=120

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
