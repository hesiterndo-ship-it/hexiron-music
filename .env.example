# ── Telegram ──────────────────────────────────────────────────────────
BOT_TOKEN=123456789:your-telegram-bot-token
API_ID=1234567
API_HASH=your-telegram-api-hash
OWNER_ID=123456789
# Comma-separated additional admin IDs (optional)
ADMIN_IDS=

# Run `python generate_session.py` once to create this
STRING_SESSION=

# ── Proxy (optional — used for Telegram connection and downloads) ─────
SOCKS5_PROXY_URL=socks5://user:pass@host:port

# ── Licensing (optional) ─────────────────────────────────────────────
# Point this at your hexiron-sales bot's internal API (running on the
# same VPS). hexiron-sales listens on PORT (default 8080) — set
# API_HOST=127.0.0.1 in hexiron-sales' own .env so it's not reachable
# from outside the VPS. CENTRAL_API_KEY must match hexiron-sales'
# API_KEY exactly. PRODUCT_ID must match the product id you create for
# "music" in the sales bot's admin panel (/admin -> Products).
CENTRAL_API_URL=http://127.0.0.1:8080
CENTRAL_API_KEY=
PRODUCT_ID=music
CENTRAL_BOT_USERNAME=your_sales_bot_username

# ── Storage paths ─────────────────────────────────────────────────────
DATA_DIR=/data
STORAGE_DIR=/data/storage
TEMP_DIR=/data/temp
DOWNLOAD_DIR=/data/downloads
UPLOAD_DIR=/data/uploads
CACHE_DIR=/data/cache
LOG_DIR=/data/logs

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=/data/hexiron.db

# ── AI integration (optional) ────────────────────────────────────────
# Liara AI is OpenAI-compatible, so AI_PROVIDER stays "openai" — just
# point AI_BASE_URL at Liara and use the API key + model name shown in
# your Liara AI console (console.liara.ir/ai -> models list).
AI_PROVIDER=openai
AI_API_KEY=your-liara-ai-api-key
AI_MODEL=openai/gpt-4o-mini
AI_BASE_URL=https://ai.liara.ir/api/v1

# ── Player defaults ──────────────────────────────────────────────────
DEFAULT_VOLUME=100
MAX_QUEUE_SIZE=200
MAX_UPLOAD_SIZE_MB=50

# ── Cleanup ──────────────────────────────────────────────────────────
TEMP_FILE_MAX_AGE_HOURS=6
CLEANUP_INTERVAL_MINUTES=30

# ── Music providers ──────────────────────────────────────────────────
# yt-dlp extraction timeout (seconds)
YTDLP_TIMEOUT=30
# Path to yt-dlp cookies file for age-restricted content (optional)
YTDLP_COOKIES_FILE=
# Generic URL download max size in bytes (default: 200MB)
GENERIC_MAX_SIZE_BYTES=209715200
# Generic URL download timeout in seconds
GENERIC_DOWNLOAD_TIMEOUT=120

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
